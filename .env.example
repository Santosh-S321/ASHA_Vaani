# Copy to .env and fill in. Never commit .env (it is in .gitignore).

# Gnani API Platform key (Prisma v3.0 STT + Timbre v3.0 TTS)
GNANI_API_KEY=

# Optional tuning
# GNANI_STT_FORMAT=codemix        # verbatim | transcribe | codemix | transliterate
# GNANI_MIN_SILENCE_MS=800        # pause (ms) that ends an utterance
# GNANI_VAD_THRESHOLD=0.7
# TTS_VOICE=Shivani               # stock Timbre v3.0 voice; no voice cloning

# LLM for extraction: any OpenAI-compatible endpoint. Leave blank to use rule-based extraction only.
# Example: Gemini via its OpenAI-compatible endpoint
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=
# Example: Groq
# LLM_BASE_URL=https://api.groq.com/openai/v1

# Encryption key for visit records at rest. Generate one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
